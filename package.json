{
  "name": "obsidian-sync-github",
  "version": "0.1.2",
  "description": "用 GitHub 同步 Obsidian 仓库的中文插件",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "keywords": [
    "obsidian",
    "github",
    "sync",
    "git"
  ],
  "author": "ch",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "builtin-modules": "^5.5.0",
    "esbuild": "^0.28.2",
    "minimatch": "^11.0.4",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.0"
  }
}
